{
  "schema": "buildguild.grader-examples.v1",
  "cases": [
    {
      "name": "update-retry-limit",
      "examples": [
        {
          "id": "correct-change",
          "description": "Only the retry setting changed.",
          "category": "pass",
          "lastMessage": "",
          "files": {
            "service.conf": "retry_limit=3\ntimeout_seconds=5\n",
            "NOTICE.txt": "Do not edit this file.\n"
          },
          "toolCalls": [],
          "expected": {
            "service-config": true,
            "notice-preserved": true
          },
          "changedFiles": [
            "service.conf"
          ]
        },
        {
          "id": "all-wrong",
          "description": "The configuration is missing and the notice changed.",
          "category": "fail",
          "lastMessage": "",
          "files": {
            "NOTICE.txt": "Edited.\n"
          },
          "toolCalls": [],
          "expected": {
            "service-config": false,
            "notice-preserved": false
          },
          "changedFiles": [
            "service.conf",
            "NOTICE.txt"
          ]
        },
        {
          "id": "wrong-retry-limit",
          "description": "The retry setting is still 2.",
          "category": "fail",
          "lastMessage": "",
          "files": {
            "service.conf": "retry_limit=2\ntimeout_seconds=5\n",
            "NOTICE.txt": "Do not edit this file.\n"
          },
          "toolCalls": [],
          "expected": {
            "service-config": false,
            "notice-preserved": true
          },
          "changedFiles": []
        },
        {
          "id": "wrong-timeout",
          "description": "The requested retry change also altered the timeout.",
          "category": "fail",
